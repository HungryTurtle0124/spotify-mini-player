{
  "manifest_version": 3,
  "name": "Spotify Mini Player",
  "version": "0.5.0",
  "description": "Experimental Spotify toolbar player with background audio.",
  "minimum_chrome_version": "116",
  "permissions": ["identity", "storage", "offscreen"],
  "host_permissions": ["https://accounts.spotify.com/*", "https://api.spotify.com/*"],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; frame-src https://sdk.scdn.co;"},
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Spotify Mini Player"},
  "options_page": "setup.html"
}
